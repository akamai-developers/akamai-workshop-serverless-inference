# Copy this file to .env and fill in your key.
#   cp .env.example .env
#
# .env is gitignored. That does not protect a key you paste into a notebook
# cell, a screenshot, or a chat message. Keep it in this file only.

# The inference endpoint. Include the /v1 suffix.
AKAMAI_BASE_URL=https://api.akamai-inference.com/v1

# Your key from docs/get-an-api-key.md
AKAMAI_API_KEY=paste_your_key_here
